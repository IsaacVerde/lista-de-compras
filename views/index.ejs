<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Minha Lista</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="container">
    
    <% if (user) { %>
      <div class="user-header">
        <span class="user-email">Logado como: <strong><%= user.email %></strong></span>
        <a href="/logout" class="btn-logout">Sair</a>
      </div>
    <% } %>

    <div class="header-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
    </div>

    <h1>Minha Lista</h1>
    <p>Organize suas compras de forma simples e eficiente</p>

    <section class="form-card">
      <form action="/add" method="POST" class="form-add-item">
        <div class="form-group form-group-nome">
          <input type="text" id="nome" name="nome" placeholder="Digite o nome do item..." required>
        </div>
        
        <div class="form-group form-group-categoria">
          <select id="categoria" name="categoria" required>
            <option value="" disabled selected>Escolha a categoria</option>
            <% Object.keys(listaDeCategorias).forEach(grupo => { %>
              <optgroup label="<%= grupo %>">
                <% listaDeCategorias[grupo].forEach(subcategoria => { %>
                  <option value="<%= subcategoria %>"><%= subcategoria %></option>
                <% }); %>
              </optgroup>
            <% }); %>
          </select>
        </div>

        <input type="hidden" name="quantidade" value="1">
        
        <button type="submit" class="btn btn-primary">+ Adicionar</button>
      </form>
    </section>

    <section class="columns-container">

      <div class="column">
        <div class="stat-card">
          <div class="stat-info">
            <span class="stat-label">Itens Pendentes</span>
            <span class="stat-number"><%= countPendentes %></span>
          </div>
          <div class="stat-icon-wrapper icon-pendente">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-box"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          </div>
        </div>

        <section class="list-container">
          <h2 class="list-title-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            Para Comprar
          </h2>
          <% if (itensPendentes.length === 0) { %>
            <p class="empty-list">Nenhum item pendente. Adicione acima!</p>
          <% } else { %>
            <ul class="item-list">
              <% itensPendentes.forEach(item => { %>
                <li class="item item-pendente">
                  
                  <form action="/toggle/<%= item.id %>" method="POST" class="form-toggle">
                    <button type="submit" class="btn-toggle"></button>
                  </form>

                  <div class="item-info">
                    <span class="item-name"><%= item.nome %></span>
                    <span class="pill <%= item.colorClass %>"><%= item.categoria %></span>
                  </div>

                  <div class="item-actions">
                    <form action="/update/<%= item.id %>?action=decrease" method="POST">
                      <button type="submit" class="btn btn-secondary btn-qty">-</button>
                    </form>
                    <span class="item-qtd"><%= item.quantidade %></span>
                    <form action="/update/<%= item.id %>?action=increase" method="POST">
                      <button type="submit" class="btn btn-secondary btn-qty">+</button>
                    </form>
                  </div>

                  <form action="/delete/<%= item.id %>" method="POST" class="form-delete">
                    <button type="submit" class="btn btn-danger">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                      </svg>
                    </button>
                  </form>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </section>
      </div>

      <div class="column">
        <div class="stat-card">
          <div class="stat-info">
            <span class="stat-label">Itens Comprados</span>
            <span class="stat-number"><%= countComprados %></span>
          </div>
          <div class="stat-icon-wrapper icon-comprado">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check-square"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
          </div>
        </div>

        <section class="list-container">
          <h2 class="list-title-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check-square"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
            Comprados
          </h2>
          <% if (itensComprados.length === 0) { %>
            <p class="empty-list">Nenhum item comprado ainda.</p>
          <% } else { %>
            <ul class="item-list">
              <% itensComprados.forEach(item => { %>
                <li class="item item-comprado">
                  
                  <form action="/toggle/<%= item.id %>" method="POST" class="form-toggle">
                    <button type="submit" class="btn-toggle btn-toggled">✓</button>
                  </form>

                  <div class="item-info">
                    <span class="item-name"><%= item.nome %></span>
                    <span class="pill <%= item.colorClass %>"><%= item.categoria %></span>
                  </div>
                  
                  <div class="item-actions">
                    <span class="item-qtd">Qtd: <%= item.quantidade %></span>
                  </div>

                  <form action="/delete/<%= item.id %>" method="POST" class="form-delete">
                    <button type="submit" class="btn btn-danger">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                      </svg>
                    </button>
                  </form>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </section>
      </div>

    </section> </div>
</body>
</html>