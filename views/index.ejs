<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Minha Lista</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    const savedTheme = localStorage.getItem('theme') || 'light';
    if (savedTheme === 'dark') {
      document.documentElement.classList.add('dark-mode'); // Aplica no <html>
    }
    // Adiciona a classe no body também por precaução, se o CSS usar .dark-mode body
    document.addEventListener('DOMContentLoaded', () => {
       if (savedTheme === 'dark') {
         document.body.classList.add('dark-mode');
       }
    });
  </script>
</head>
<body>

  <header class="main-header">
    <div class="logo-container">
      <div class="logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
      </div>
      <span class="logo-text">Minha Lista</span>
    </div>

    <% if (user) { %>
      <div class="user-info">
        <span class="user-email">Logado como: <strong><%= user.email %></strong></span>
        <a href="/logout" class="btn-logout-header">Sair</a>
      </div>
    <% } else { %>
      <div class="login-forms-container">
        <form action="/login" method="POST" class="form-header-login">
          <input type="email" name="email" placeholder="Email" required>
          <input type="password" name="password" placeholder="Senha" required>
          <button type="submit" class="btn btn-primary">Login</button>
        </form>
        <a href="/auth/google" class="btn-google-header">Login com Google</a>
        <a href="/register" class="link-register">Não tem conta? Registe-se</a>
        <% if (loginError && loginError.length > 0) { %>
          <div class="login-error"><%= loginError[0] %></div>
        <% } %>
      </div>
    <% } %>
  </header>

  <div class="container">
    
    <% if (user) { %>
      <div class="header-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
      </div>
      <h1>Minha Lista</h1>
      <p>Organize suas compras de forma simples e eficiente</p>

      <section class="form-card">
        <form action="/add" method="POST" class="form-add-item">
          <div class="form-group form-group-nome">
            <input type="text" id="nome" name="nome" placeholder="Digite o nome do item..." required>
          </div>
          <div class="form-group form-group-categoria">
            <select id="categoria" name="categoria" required>
              <option value="" disabled selected>Escolha a categoria</option>
              <% Object.keys(listaDeCategorias).forEach(grupo => { %>
                <optgroup label="<%= grupo %>">
                  <% listaDeCategorias[grupo].forEach(subcategoria => { %>
                    <option value="<%= subcategoria %>"><%= subcategoria %></option>
                  <% }); %>
                </optgroup>
              <% }); %>
            </select>
          </div>
          <input type="hidden" name="quantidade" value="1">
          <button type="submit" class="btn btn-primary">+ Adicionar</button>
        </form>
      </section>

      <section class="columns-container">
        <div class="column">
          <div class="stat-card">
            <div class="stat-info">
              <span class="stat-label">Itens Pendentes</span>
              <span class="stat-number"><%= countPendentes %></span>
            </div>
            <div class="stat-icon-wrapper icon-pendente">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-box"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            </div>
          </div>
          <section class="list-container">
            <h2 class="list-title-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              Para Comprar
            </h2>
            <% if (itensPendentes.length === 0) { %>
              <p class="empty-list">Nenhum item pendente. Adicione acima!</p>
            <% } else { %>
              <ul class="item-list">
                <% itensPendentes.forEach(item => { %>
                  <li class="item item-pendente">
                    <form action="/toggle/<%= item.id %>" method="POST" class="form-toggle"> <button type="submit" class="btn-toggle"></button> </form>
                    <div class="item-info"> <span class="item-name"><%= item.nome %></span> <span class="pill <%= item.colorClass %>"><%= item.categoria %></span> </div>
                    <div class="item-actions"> <form action="/update/<%= item.id %>?action=decrease" method="POST"> <button type="submit" class="btn btn-secondary btn-qty">-</button> </form> <span class="item-qtd"><%= item.quantidade %></span> <form action="/update/<%= item.id %>?action=increase" method="POST"> <button type="submit" class="btn btn-secondary btn-qty">+</button> </form> </div>
                    <form action="/delete/<%= item.id %>" method="POST" class="form-delete"> <button type="submit" class="btn btn-danger"> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"> <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/> <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/> </svg> </button> </form>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </section>
        </div>
        <div class="column">
           <div class="stat-card">
            <div class="stat-info"> <span class="stat-label">Itens Comprados</span> <span class="stat-number"><%= countComprados %></span> </div> <div class="stat-icon-wrapper icon-comprado"> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check-square"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg> </div>
          </div>
          <section class="list-container">
            <h2 class="list-title-icon">
             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check-square"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
              Comprados
            </h2>
             <% if (itensComprados.length === 0) { %>
              <p class="empty-list">Nenhum item comprado ainda.</p>
            <% } else { %>
              <ul class="item-list">
                <% itensComprados.forEach(item => { %>
                 <li class="item item-comprado">
                    <form action="/toggle/<%= item.id %>" method="POST" class="form-toggle"> <button type="submit" class="btn-toggle btn-toggled">✓</button> </form>
                    <div class="item-info"> <span class="item-name"><%= item.nome %></span> <span class="pill <%= item.colorClass %>"><%= item.categoria %></span> </div>
                    <div class="item-actions"> <span class="item-qtd">Qtd: <%= item.quantidade %></span> </div>
                    <form action="/delete/<%= item.id %>" method="POST" class="form-delete"> <button type="submit" class="btn btn-danger"> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"> <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/> <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/> </svg> </button> </form>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </section>
        </div>
      </section> <% } else { %>
      <div class="welcome-container">
        <div class="header-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        </div>
        <h1>Bem-vindo ao Minha Lista!</h1>
        <p>Faça login ou registe-se no cabeçalho para começar a gerir as suas compras.</p>
      </div>
    <% } %>

  </div> <button id="theme-toggle">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-sun"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
  </button>

  <script>
    const themeToggle = document.getElementById('theme-toggle');
    const body = document.body;
    const htmlElement = document.documentElement; // Pega o elemento <html>

    // Ícones SVG
    const sunIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-sun"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>`;
    const moonIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-moon"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>`;

    // Função para definir o tema e guardar
    function setTheme(theme) {
      if (theme === 'dark') {
        htmlElement.classList.add('dark-mode');
        body.classList.add('dark-mode'); // Adiciona em ambos por segurança
        themeToggle.innerHTML = sunIcon; // Mostra ícone de sol
        localStorage.setItem('theme', 'dark');
      } else {
        htmlElement.classList.remove('dark-mode');
        body.classList.remove('dark-mode'); // Remove de ambos
        themeToggle.innerHTML = moonIcon; // Mostra ícone de lua
        localStorage.setItem('theme', 'light');
      }
    }

    // Verifica tema guardado ao carregar (O script no <head> já faz a parte inicial)
    // Este bloco só garante que o ícone do botão esteja correto ao carregar
    const currentTheme = localStorage.getItem('theme') || 'light';
    if (currentTheme === 'dark') {
        themeToggle.innerHTML = sunIcon;
    } else {
        themeToggle.innerHTML = moonIcon;
    }


    // Event listener para o botão
    themeToggle.addEventListener('click', () => {
      // Verifica o tema ATUAL pelo elemento <html>
      const isDarkMode = htmlElement.classList.contains('dark-mode');
      setTheme(isDarkMode ? 'light' : 'dark'); // Inverte o tema
    });
  </script>

</body>
</html> 